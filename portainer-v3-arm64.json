{
  "version": "3",
  "templates": [
    {
      "id": 2001,
      "type": 1,
      "title": "Caddy ARM64",
      "description": "Servidor web y proxy inverso con HTTPS automático.",
      "categories": [
        "webserver",
        "proxy"
      ],
      "platform": "linux",
      "image": "caddy:2-alpine",
      "ports": [
        "80/tcp",
        "443/tcp",
        "443/udp"
      ],
      "volumes": [
        {
          "container": "/data"
        },
        {
          "container": "/config"
        },
        {
          "container": "/etc/caddy"
        }
      ]
    },
    {
      "id": 2002,
      "type": 1,
      "title": "Nginx ARM64",
      "description": "Servidor web ligero.",
      "categories": [
        "webserver"
      ],
      "platform": "linux",
      "image": "nginx:1.27-alpine",
      "ports": [
        "80/tcp",
        "443/tcp"
      ],
      "volumes": [
        {
          "container": "/usr/share/nginx/html"
        },
        {
          "container": "/etc/nginx"
        }
      ]
    },
    {
      "id": 2003,
      "type": 1,
      "title": "Jellyfin ARM64",
      "description": "Servidor multimedia para películas, música y series.",
      "categories": [
        "media"
      ],
      "platform": "linux",
      "image": "jellyfin/jellyfin:latest",
      "ports": [
        "8096/tcp",
        "8920/tcp",
        "7359/udp"
      ],
      "volumes": [
        {
          "container": "/config"
        },
        {
          "container": "/cache"
        },
        {
          "container": "/media"
        }
      ],
      "note": "La transcodificación depende del hardware."
    },
    {
      "id": 2004,
      "type": 1,
      "title": "Navidrome ARM64",
      "description": "Servidor de música compatible con Subsonic.",
      "categories": [
        "media"
      ],
      "platform": "linux",
      "image": "deluan/navidrome:latest",
      "ports": [
        "4533/tcp"
      ],
      "volumes": [
        {
          "container": "/data"
        },
        {
          "container": "/music"
        }
      ]
    },
    {
      "id": 2005,
      "type": 1,
      "title": "File Browser ARM64",
      "description": "Administrador web de archivos.",
      "categories": [
        "storage"
      ],
      "platform": "linux",
      "image": "filebrowser/filebrowser:latest",
      "ports": [
        "80/tcp"
      ],
      "volumes": [
        {
          "container": "/srv"
        },
        {
          "container": "/database"
        },
        {
          "container": "/config"
        }
      ]
    },
    {
      "id": 2006,
      "type": 1,
      "title": "Syncthing ARM64",
      "description": "Sincronización directa de archivos.",
      "categories": [
        "storage",
        "backup"
      ],
      "platform": "linux",
      "image": "syncthing/syncthing:latest",
      "ports": [
        "8384/tcp",
        "22000/tcp",
        "22000/udp",
        "21027/udp"
      ],
      "volumes": [
        {
          "container": "/var/syncthing"
        }
      ]
    },
    {
      "id": 2007,
      "type": 1,
      "title": "MariaDB ARM64",
      "description": "Base de datos compatible con MySQL.",
      "categories": [
        "database"
      ],
      "platform": "linux",
      "image": "mariadb:11",
      "ports": [
        "3306/tcp"
      ],
      "env": [
        {
          "name": "MARIADB_ROOT_PASSWORD",
          "label": "Contraseña root"
        },
        {
          "name": "MARIADB_DATABASE",
          "label": "Base de datos",
          "default": "app"
        },
        {
          "name": "MARIADB_USER",
          "label": "Usuario",
          "default": "app"
        },
        {
          "name": "MARIADB_PASSWORD",
          "label": "Contraseña del usuario"
        }
      ],
      "volumes": [
        {
          "container": "/var/lib/mysql"
        }
      ]
    },
    {
      "id": 2008,
      "type": 1,
      "title": "PostgreSQL ARM64",
      "description": "Base de datos relacional avanzada.",
      "categories": [
        "database"
      ],
      "platform": "linux",
      "image": "postgres:16-alpine",
      "ports": [
        "5432/tcp"
      ],
      "env": [
        {
          "name": "POSTGRES_USER",
          "label": "Usuario",
          "default": "app"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "label": "Contraseña"
        },
        {
          "name": "POSTGRES_DB",
          "label": "Base de datos",
          "default": "app"
        }
      ],
      "volumes": [
        {
          "container": "/var/lib/postgresql/data"
        }
      ]
    },
    {
      "id": 2009,
      "type": 1,
      "title": "Redis ARM64",
      "description": "Caché y almacén de datos en memoria.",
      "categories": [
        "database",
        "cache"
      ],
      "platform": "linux",
      "image": "redis:7-alpine",
      "ports": [
        "6379/tcp"
      ],
      "command": "redis-server --appendonly yes",
      "volumes": [
        {
          "container": "/data"
        }
      ]
    },
    {
      "id": 2010,
      "type": 1,
      "title": "MongoDB ARM64",
      "description": "Base de datos documental NoSQL.",
      "categories": [
        "database"
      ],
      "platform": "linux",
      "image": "mongo:8",
      "ports": [
        "27017/tcp"
      ],
      "env": [
        {
          "name": "MONGO_INITDB_ROOT_USERNAME",
          "label": "Usuario root",
          "default": "admin"
        },
        {
          "name": "MONGO_INITDB_ROOT_PASSWORD",
          "label": "Contraseña root"
        }
      ],
      "volumes": [
        {
          "container": "/data/db"
        },
        {
          "container": "/data/configdb"
        }
      ]
    },
    {
      "id": 2011,
      "type": 1,
      "title": "MinIO ARM64",
      "description": "Almacenamiento de objetos compatible con S3.",
      "categories": [
        "storage"
      ],
      "platform": "linux",
      "image": "quay.io/minio/minio:latest",
      "ports": [
        "9000/tcp",
        "9001/tcp"
      ],
      "command": "server /data --console-address :9001",
      "env": [
        {
          "name": "MINIO_ROOT_USER",
          "label": "Usuario root",
          "default": "minioadmin"
        },
        {
          "name": "MINIO_ROOT_PASSWORD",
          "label": "Contraseña root"
        }
      ],
      "volumes": [
        {
          "container": "/data"
        }
      ]
    },
    {
      "id": 2012,
      "type": 1,
      "title": "Mosquitto ARM64",
      "description": "Broker MQTT para IoT.",
      "categories": [
        "iot",
        "messaging"
      ],
      "platform": "linux",
      "image": "eclipse-mosquitto:2",
      "ports": [
        "1883/tcp",
        "8883/tcp"
      ],
      "volumes": [
        {
          "container": "/mosquitto/config"
        },
        {
          "container": "/mosquitto/data"
        },
        {
          "container": "/mosquitto/log"
        }
      ]
    },
    {
      "id": 2013,
      "type": 1,
      "title": "Node-RED ARM64",
      "description": "Automatización visual e integración de servicios.",
      "categories": [
        "automation",
        "iot"
      ],
      "platform": "linux",
      "image": "nodered/node-red:latest",
      "ports": [
        "1880/tcp"
      ],
      "volumes": [
        {
          "container": "/data"
        }
      ]
    },
    {
      "id": 2014,
      "type": 1,
      "title": "Uptime Kuma ARM64",
      "description": "Monitor de disponibilidad con panel web.",
      "categories": [
        "monitoring"
      ],
      "platform": "linux",
      "image": "louislam/uptime-kuma:1",
      "ports": [
        "3001/tcp"
      ],
      "volumes": [
        {
          "container": "/app/data"
        }
      ]
    },
    {
      "id": 2015,
      "type": 1,
      "title": "Dozzle ARM64",
      "description": "Visor web de logs Docker.",
      "categories": [
        "monitoring",
        "management"
      ],
      "platform": "linux",
      "image": "amir20/dozzle:latest",
      "ports": [
        "8080/tcp"
      ],
      "volumes": [
        {
          "container": "/var/run/docker.sock",
          "bind": "/var/run/docker.sock",
          "ro": true
        }
      ]
    },
    {
      "id": 2016,
      "type": 1,
      "title": "Portainer Agent ARM64",
      "description": "Agente para administrar otro Docker Engine.",
      "categories": [
        "management"
      ],
      "platform": "linux",
      "image": "portainer/agent:latest",
      "ports": [
        "9001/tcp"
      ],
      "volumes": [
        {
          "container": "/var/run/docker.sock",
          "bind": "/var/run/docker.sock"
        },
        {
          "container": "/var/lib/docker/volumes",
          "bind": "/var/lib/docker/volumes"
        }
      ]
    },
    {
      "id": 2017,
      "type": 1,
      "title": "Watchtower ARM64",
      "description": "Actualización automática de contenedores.",
      "categories": [
        "management"
      ],
      "platform": "linux",
      "image": "containrrr/watchtower:latest",
      "env": [
        {
          "name": "WATCHTOWER_CLEANUP",
          "label": "Eliminar imágenes antiguas",
          "default": "true",
          "preset": true
        },
        {
          "name": "WATCHTOWER_SCHEDULE",
          "label": "Programación cron",
          "default": "0 0 4 * * *"
        }
      ],
      "volumes": [
        {
          "container": "/var/run/docker.sock",
          "bind": "/var/run/docker.sock"
        }
      ]
    },
    {
      "id": 2018,
      "type": 1,
      "title": "SFTPGo ARM64",
      "description": "Servidor SFTP, FTP, WebDAV y HTTP.",
      "categories": [
        "storage",
        "network"
      ],
      "platform": "linux",
      "image": "drakkan/sftpgo:latest",
      "ports": [
        "2022/tcp",
        "8080/tcp",
        "10080/tcp"
      ],
      "volumes": [
        {
          "container": "/var/lib/sftpgo"
        },
        {
          "container": "/srv/sftpgo"
        }
      ]
    },
    {
      "id": 2019,
      "type": 1,
      "title": "Vaultwarden ARM64",
      "description": "Servidor compatible con clientes Bitwarden.",
      "categories": [
        "security"
      ],
      "platform": "linux",
      "image": "vaultwarden/server:latest",
      "ports": [
        "80/tcp"
      ],
      "env": [
        {
          "name": "SIGNUPS_ALLOWED",
          "label": "Permitir registros",
          "default": "false"
        }
      ],
      "volumes": [
        {
          "container": "/data"
        }
      ],
      "note": "Usar siempre detrás de HTTPS."
    },
    {
      "id": 2020,
      "type": 1,
      "title": "Alpine ARM64",
      "description": "Contenedor mínimo para pruebas y utilidades.",
      "categories": [
        "development",
        "operating-system"
      ],
      "platform": "linux",
      "image": "alpine:3.22",
      "interactive": true,
      "command": "/bin/sh"
    },
    {
      "id": 2021,
      "type": 1,
      "title": "Debian ARM64",
      "description": "Contenedor Debian para administración y desarrollo.",
      "categories": [
        "development",
        "operating-system"
      ],
      "platform": "linux",
      "image": "debian:13-slim",
      "interactive": true,
      "command": "/bin/bash"
    },
    {
      "id": 2022,
      "type": 1,
      "title": "Python ARM64",
      "description": "Entorno Python para scripts y servicios.",
      "categories": [
        "development"
      ],
      "platform": "linux",
      "image": "python:3.13-slim",
      "interactive": true,
      "command": "/bin/bash"
    },
    {
      "id": 2023,
      "type": 1,
      "title": "Node.js ARM64",
      "description": "Entorno Node.js para aplicaciones web.",
      "categories": [
        "development"
      ],
      "platform": "linux",
      "image": "node:22-bookworm-slim",
      "interactive": true,
      "command": "/bin/bash"
    }
  ]
}
